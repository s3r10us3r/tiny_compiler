// ============================================================
// TEST: 'class' keyword — identical to 'struct', methods included
// Expected output: 24 20 0 25 1
// ============================================================

class Rectangle {
    width: int;
    height: int;

    fn area(self) -> int {
        return self.width * self.height;
    };

    fn perimeter(self) -> int {
        return 2 * (self.width + self.height);
    };

    fn is_square(self) -> bool {
        return self.width == self.height;
    };
};

let r: Rectangle = new Rectangle { width = 4, height = 6 };
print r.area();         // 4 * 6 = 24
print r.perimeter();    // 2 * (4 + 6) = 20
print r.is_square();    // 0 (4 != 6)

let sq: Rectangle = new Rectangle { width = 5, height = 5 };
print sq.area();        // 5 * 5 = 25
print sq.is_square();   // 1 (5 == 5)
