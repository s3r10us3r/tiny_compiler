// ============================================================
// TEST: function and method call errors
//       TypeChecker collects all errors.
//
// Expected errors:
//   "Function 'add' expects"            (wrong fn arg count)
//   "type mismatch in call to 'add'"    (wrong fn arg type)
//   "Method call on non-struct"         (calling method on int)
//   "has no methods"                    (struct with no methods)
//   "has no method '"                   (unknown method name)
//   "Method 'set' expects"             (wrong method arg count)
//   "type mismatch in call to 'set'"   (wrong method arg type)
// ============================================================

// --- Function with two int params ---
fn add(a: int, b: int) -> int { return a + b; };

// --- Struct with a method ---
struct Counter {
    val: int;
    fn set(self, v: int) -> void { self.val = v; };
};

// --- Struct without any methods ---
struct Plain { x: int; };

// ---- Function call errors ----

// Too few arguments
let r1: int = add(1);                // ERROR: 'add' expects 2 argument(s), got 1

// Wrong argument type (float instead of int for param b)
let r2: int = add(1, 3.14);         // ERROR: type mismatch in call to 'add'

// ---- Method call errors ----

// Method call on a non-struct (int) value
let n: int = 5;
n.set(1);                            // ERROR: method call on non-struct type

// Struct has no methods at all
let p: Plain = new Plain { x = 0 };
p.get();                             // ERROR: Plain has no methods

// Unknown method on a struct that has methods
let c: Counter = new Counter { val = 0 };
c.nonexistent();                     // ERROR: Counter has no method 'nonexistent'

// Wrong method arg count (set expects 1 arg, given 0)
c.set();                             // ERROR: 'set' expects 1 argument(s)

// Wrong method arg type (float instead of int)
c.set(3.14);                         // ERROR: type mismatch in call to 'set'
