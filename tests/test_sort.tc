// ============================================================
// TEST: bubble sort — exercises arrays, nested while, if, swap
// Expected output: 1 2 3 5 8 9
// ============================================================

let arr: int[6] = 0;
arr[0] = 5;
arr[1] = 2;
arr[2] = 8;
arr[3] = 1;
arr[4] = 9;
arr[5] = 3;

let n: int = 6;
let i: int = 0;

while i < n {
    let j: int = 0;
    while j < n - 1 {
        if arr[j] > arr[j + 1] {
            let tmp: int = arr[j];
            arr[j]     = arr[j + 1];
            arr[j + 1] = tmp;
        };
        j = j + 1;
    };
    i = i + 1;
};

let k: int = 0;
while k < 6 {
    print arr[k];
    k = k + 1;
};
