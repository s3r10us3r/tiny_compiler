// ============================================================
// TEST: global variable access from functions
// Expected output: 10 20 30 1 99
// ============================================================

let counter: int = 0;
let flag: bool = false;

// Function declared before 'base' is defined — tests forward visibility.
fn add_to_base(n: int) -> int {
    return base + n;
};

let base: int = 10;

// Read a global, return modified value.
fn get_counter() -> int {
    return counter;
};

// Write to a global.
fn increment() -> void {
    counter = counter + 1;
};

// Globals shadow correctly inside function locals.
fn local_shadow() -> int {
    let base: int = 99;
    return base;   // returns 99, not the global 10
};

increment();
increment();
increment();
counter = counter * 3 + 1;   // (3*3)+1 = 10
print get_counter();          // 10

counter = 20;
print get_counter();          // 20

print add_to_base(20);        // base(10) + 20 = 30

flag = true;
print flag;                   // 1

print local_shadow();         // 99 (local shadows global)
