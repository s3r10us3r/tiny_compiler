// ============================================================
// TEST: if / else / else-if
// Expected output (one per line): 1  0  2  42
// ============================================================

// 1. Basic if — condition true
let x: int = 5;
if x > 3 {
    print 1;
};

// 2. if-else — condition false → else branch
let y: int = 2;
if y > 3 {
    print 99;
} else {
    print 0;
};

// 3. else-if chain — middle branch taken
let z: int = 10;
if z < 5 {
    print 1;
} else if z < 15 {
    print 2;
} else {
    print 3;
};

// 4. Nested if
let a: int = 7;
if a > 0 {
    if a > 5 {
        print 42;
    };
};
