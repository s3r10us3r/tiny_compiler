// ═══════════════════════════════════════════════════════════════════
// SHOWCASE — Semantic Errors (TypeChecker)
//
// The TypeChecker runs a FULL pass and collects every error
// before printing them — you see ALL problems at once.
//
// Expected: compilation failure with 10 distinct errors.
// ═══════════════════════════════════════════════════════════════════

// ── 1. Duplicate type declaration ────────────────────────────────
struct Point { x: int; y: int; };
struct Point { x: float; };              // ❌ Point already defined

// ── 2. Duplicate function declaration ────────────────────────────
fn greet(name: int) -> int { return name; };
fn greet(a: int, b: int) -> int { return a; };  // ❌ greet already defined

// ── 3. Duplicate field in struct ─────────────────────────────────
struct Broken { val: int; val: float; }; // ❌ duplicate field 'val'

// ── 4. Duplicate method in struct ────────────────────────────────
struct Counter {
    n: int;
    fn get(self) -> int { return self.n; };
    fn get(self) -> int { return 0; };   // ❌ duplicate method 'get'
};

// Helper — used in tests 7 & 8 below (no duplicate, so no overwrite issue)
fn add(a: int, b: int) -> int { return a + b; };

// ── 5. Type mismatch in variable initialisation ──────────────────
let x: int = 3.14;                       // ❌ float given, int expected

// ── 6. Undeclared variable ───────────────────────────────────────
let y: int = ghost + 1;                  // ❌ 'ghost' is not declared

// ── 7. Wrong argument count ──────────────────────────────────────
let r1: int = add(1);                    // ❌ add expects 2 args, got 1

// ── 8. Wrong argument type ───────────────────────────────────────
let r2: int = add(1, 3.14);             // ❌ float passed, int expected

// ── 9. Return type mismatch ──────────────────────────────────────
fn make_int(n: int) -> int {
    return 3.14;                         // ❌ float returned from int function
};

// ── 10. while condition is not boolean ───────────────────────────
let count: int = 10;
while (count) {                          // ❌ int is not a boolean condition
    count = count - 1;
};
