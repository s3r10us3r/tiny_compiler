// ═══════════════════════════════════════════════════════════════════
// SHOWCASE 3 — Structs / Classes · Methods · Nested · Value-Copy
// Expected output: 25  0  100  1  1  0
// ═══════════════════════════════════════════════════════════════════

// 'class' and 'struct' are identical keywords — pick whichever reads better.

class Vec2 {
    x: int;
    y: int;

    // Getter (pure query — does not modify self)
    fn length_sq(self) -> int {
        return self.x * self.x + self.y * self.y;
    };

    // Mutating method — self is a pointer so changes persist on the caller
    fn scale(self, t: int) -> void {
        self.x = self.x * t;
        self.y = self.y * t;
    };

    fn is_zero(self) -> bool {
        return self.x == 0 and self.y == 0;
    };
};

// ── Nested struct: Segment holds two Vec2 endpoints ──────────────
struct Segment {
    a: Vec2;
    b: Vec2;
};

// ── Basic method calls ────────────────────────────────────────────
let v: Vec2 = new Vec2 { x = 3, y = 4 };

print v.length_sq();    // 25   (3²+4² = 25)
print v.is_zero();      // 0    (false)

v.scale(2);             // mutates v in-place through self pointer
print v.length_sq();    // 100  (6²+8² = 100)

// ── Value-copy semantics ──────────────────────────────────────────
// Assigning a struct to a field COPIES the value at that moment.
// Later mutations to the original do NOT affect the copy.

let u: Vec2    = new Vec2    { x = 1, y = 0 };
let seg: Segment = new Segment { a = u, b = v };  // seg.a is a copy of u

print seg.a.x;   // 1   ← copy captured when Segment was created

u.x = 99;        // mutate u after the assignment

print seg.a.x;   // 1   ← still 1; seg.a is independent of u
print u.is_zero();  // 0 ← u.x is now 99, so not zero
